---
import Base from '../../layouts/Base.astro';

const skills = [
  {
    href: '/skills/transcribe',
    name: 'transcribe',
    line: 'Turn a long recording into the document someone would otherwise spend a day writing: TL;DR, decisions, glossary, full transcript.',
  },
  {
    href: '/skills/factory',
    name: 'factory',
    line: 'A coding-agent orchestrator that works a repo’s issues end to end on free or $10/month models, and shows it all as a factory floor you can steer.',
  },
];
---
<Base title="Claude Code skills · Dihan Nahdi" description="Open-source Claude Code skills by Dihan Nahdi.">
  <section class="wrap" style="padding: 72px 0 0;">
    <p class="eyebrow">Open source</p>
    <h1>Claude Code skills</h1>
    <p class="hero__bio" style="margin-top: 12px;">Tools I built for my own work and cleaned up for anyone to use.</p>
    <ul class="timeline" style="margin-top: 32px;">
      {skills.map((s) => (
        <li>
          <a class="timeline__when" href={s.href} style="font-weight: 700; color: var(--ink); font-size: 16px;">{s.name}</a>
          <p class="timeline__line">{s.line}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
